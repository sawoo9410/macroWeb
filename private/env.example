# macroweb — private/.env 의 변수 이름 목록 (값은 절대 커밋하지 않는다)
# Track A (일일 추출·배치): Anthropic API 키. 주간 편집국은 claude -p 구독 경로라 이 키를 쓰지 않는다 (ADR-0002).
ANTHROPIC_API_KEY=
# 데이터 API
FRED_API_KEY=
ECOS_API_KEY=
DART_API_KEY=
# 알림 (기존 봇 토큰 재사용, 채팅방은 별도 — PLAN §0.3)
TELEGRAM_BOT_TOKEN=
MACROWEB_TELEGRAM_CHAT_ID=
# 선택: 데이터 디렉터리 재지정 (기본 ./data)
# MACROWEB_DATA_DIR=
# 선택: 주간 실행기 인증 모드 subscription | api (기본 subscription, ADR-0002)
# MACROWEB_WEEKLY_AUTH=subscription
