# macroweb — private/.env 의 변수 이름 목록 (값은 절대 커밋하지 않는다)
# 선택: Anthropic API 키. 기본 설정(ADR-0002·0007)은 주간·일일 모두 Max 구독의 claude -p 를 쓰므로 비워 둬도 된다.
# 값을 넣어도 러너는 자식 claude 프로세스 환경에서 이 변수를 제거한다. models.yaml 의 *_runner.mode 를 api 로 바꿀 때만 쓰인다.
ANTHROPIC_API_KEY=
# 데이터 API
FRED_API_KEY=
ECOS_API_KEY=
DART_API_KEY=
# 알림 (기존 봇 토큰 재사용, 채팅방은 별도 — PLAN §0.3)
TELEGRAM_BOT_TOKEN=
MACROWEB_TELEGRAM_CHAT_ID=
# 선택: 데이터 디렉터리 재지정 (기본 ./data)
# MACROWEB_DATA_DIR=
# 선택: 주간 실행기 인증 모드 subscription | api (기본 subscription, ADR-0002)
# MACROWEB_WEEKLY_AUTH=subscription
